# Supabase — copy this file to .env.local and fill in your project values.
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Use your project's publishable key (sb_publishable_...). The legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# The public base URL of the app (used for the OAuth redirect).
# In local dev this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
